{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "SBD — Chọn Zoom · Tự x & ghi chú",
  "version": "1.1.5",
  "description": "Theo dõi SBD, tên và bài đã nộp; tự ghi chữ x và ghi chú cả dòng nguồn vào ô Nộp Bài.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://sheets.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Mở theo dõi SBD"
  },
  "icons": {
    "128": "icon.png"
  },
  "key": "",
  "oauth2": {
    "client_id": "483826966485-lvk877grp76a1jkru1tdjji6bg20o3al.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets"
    ]
  }
}